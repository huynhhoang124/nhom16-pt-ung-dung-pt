# Sao chép thành .env rồi sửa:  cp .env.example .env
# Máy demo / bảo vệ: thay 2 khoá dưới bằng chuỗi ngẫu nhiên, vd:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Khoá nội bộ giữa Aggregator/barrier và Parking Node
INTERNAL_KEY=doi-thanh-chuoi-ngau-nhien-1
# Khoá ký JWT đăng nhập
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-2
# Mật khẩu chung của các tài khoản demo (user1, staff-a, admin...)
DEMO_PASSWORD=123456
# Số phút giữ chỗ khi đặt
RESERVATION_MINUTES=15

# PT-05 (tuỳ chọn): cặp khoá RS256 để nhân viên vẫn làm việc khi Aggregator sập.
# Sinh tự động vào .env:  node scripts/gen-keys.mjs
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=

# Chỉ khi chạy --profile ha thì bỏ dấu # ở 2 dòng dưới. Không bật ha mà vẫn bật 2 dòng này thì hệ thống chậm
# (phải chờ kết nối/tra DNS tới máy không tồn tại).
# PT-02: node A đọc thuần từ bản sao DB
# A_READ_DATABASE_URL=postgres://postgres:dev@db-a-replica/parking
# PT-03: cụm RabbitMQ 3 nút
# RABBITMQ_URL=amqp://parking:parking@rabbitmq,amqp://parking:parking@rabbitmq-2,amqp://parking:parking@rabbitmq-3
